{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@plugins/*": ["src/plugins/*"],
      "@worker/*": ["src/worker/*"],
      "@tier3/*": ["src/tier3/*"],
      "@output/*": ["src/output/*"],
      "@ui/*": ["src/ui/*"],
      "@commands/*": ["src/commands/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".vscode-test",
    "src/test/fixtures/**"
  ]
}
